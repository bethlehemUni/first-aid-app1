{
  "name": "scan-learn-act-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor wrapper (Android + iOS) for the SCAN, LEARN & ACT first-aid website",
  "scripts": {
    "sync-web": "node scripts/sync-web.mjs",
    "assets": "capacitor-assets generate --iconBackgroundColor \"#1c2b5c\" --splashBackgroundColor \"#ffffff\"",
    "sync": "cap sync",
    "android:open": "cap open android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release-aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2"
  }
}